{
  "uid": "llm-sim-hw11",
  "title": "HW11 llm-sim (backend_mode=simulated)",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "hw11"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "TTFC (до первой части), p50/p95 по Pod",
      "description": "classic histogram: перцентиль из суммарных bucket-счётчиков, le сохраняется",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(llm_ttfc_seconds_bucket{namespace=\"llm\"}[1m])))",
          "legendFormat": "p95 {{pod}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, pod) (rate(llm_ttfc_seconds_bucket{namespace=\"llm\"}[1m])))",
          "legendFormat": "p50 {{pod}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_ttfc_seconds_bucket{namespace=\"llm\"}[1m])))",
          "legendFormat": "p95 все Pod",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Длительность полного ответа, p95 по Pod",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(llm_request_duration_seconds_bucket{namespace=\"llm\"}[1m])))",
          "legendFormat": "p95 {{pod}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_queue_wait_seconds_bucket{namespace=\"llm\"}[1m])))",
          "legendFormat": "p95 ожидание очереди (все)",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "running / waiting по Pod",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (llm_running{namespace=\"llm\"})",
          "legendFormat": "running {{pod}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (llm_waiting{namespace=\"llm\"})",
          "legendFormat": "waiting {{pod}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
