    },
    {
      "type": "timeseries",
      "title": "Ошибки и отказы/с по исходу",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
