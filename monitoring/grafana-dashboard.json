          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(llm_requests_total{namespace=\"llm\", outcome!=\"ok\"}[1m])) / sum(rate(llm_requests_total{namespace=\"llm\"}[1m]))",
